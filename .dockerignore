# Git
.git
.gitignore
.github/
.gitlab-ci.yml

# Docker
.dockerignore
Dockerfile

# Локальні конфіги та секрети
/config/master.key
/config/credentials.local.yml
.env
.env.*

# Локальні папки з кешем, логами та тимчасовими файлами
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
!/tmp/pids/.keep
!/tmp/cache/.keep

# База даних та локальні завантаження
/storage/*
!/storage/.keep

# Залежності (Ruby та Node)
/vendor/bundle
/.bundle
node_modules/

# Зібрані ассети (вони збираються заново всередині Docker)
/public/assets
/public/packs
/app/assets/builds/*
!/app/assets/builds/.keep

# Тести та історія
/spec/
/test/
.byebug_history
.irb_history
