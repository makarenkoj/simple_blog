<div class="max-w-md mx-auto mt-12 bg-white p-6 rounded-lg shadow-md">
  <h2 class="text-xl font-bold text-gray-800 mb-4 text-center"><%= t("devise.sessions.new.sign_in") %></h2>
  <% if flash.any? %>
    <div class="mb-4">
      <% flash.each do |key, value| %>
        <div class="rounded-lg p-4 text-sm text-gray-800 <%= flash_class(key) %>" role="alert">
          <%= value %>
        </div>
      <% end %>
    </div>
  <% end %>
  <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }, data: { turbo: "false" }) do |f| %>
    <div class="form-inputs space-y-3">
      <%= f.input :email,
        required: false,
        autofocus: true,
        input_html: {
          autocomplete: "email",
          class: "w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        },
        label: t('devise.form.email') %>
      <%= f.input :password, required: false, label: t("devise.form.password") do %>
        <div class="relative" data-controller="password-visibility">
          <%= f.input_field :password,
                autocomplete: "current-password",
                data: { password_visibility_target: "input" },
                class: "w-full px-3 py-2 pr-12 text-sm text-gray-900 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          
          <button type="button" class="absolute inset-y-0 right-1 flex items-center pr-3 text-gray-400 hover:text-gray-600 focus:outline-none" data-action="click->password-visibility#toggle">
            <svg class="h-5 w-5" data-password-visibility-target="eye" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            <svg class="h-5 w-5 hidden" data-password-visibility-target="eyeSlash" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
            </svg>
          </button>
        </div>
      <% end %>
      <% if devise_mapping.rememberable? %>
        <div class="flex items-center space-x-2">
          <%= f.input :remember_me,
            as: :boolean,
            label: t("devise.sessions.new.remember_me"),
            wrapper_html: { class: "flex items-center m-0" },
            input_html: { class: "w-4 h-4 rounded border-gray-300 text-blue-600 shadow-sm focus:ring-blue-500 cursor-pointer" },
            label_html: { class: "ml-2 text-sm text-gray-700 cursor-pointer mb-0" } %>
        </div>
      <% end %>
    </div>
    <div class="form-actions">
      <%= f.button :submit, t("devise.sessions.new.sign_in"), class: "w-full bg-blue-600 hover:bg-blue-700 text-gray-800 text-sm font-semibold py-2 px-4 rounded-md shadow focus:outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer" %>
    </div>
  <% end %>
  <div class="mt-4 text-center text-sm text-gray-600 space-x-2">
    <%= link_to t("devise.shared.links.sign_up"), new_registration_path(resource_name), title: t("devise.shared.links.sign_up"), class: "text-blue-600 hover:underline" %>
    |
    <%= link_to t("devise.shared.links.forgot_your_password"), new_password_path(resource_name), title: t("devise.shared.links.forgot_your_password"), class: "text-blue-600 hover:underline" %>
  </div>
</div>
