<div class="max-w-md mx-auto mt-12 bg-white p-6 rounded-lg shadow-md">
  <h2 class="text-xl font-bold text-gray-800 mb-4 text-center">
    <%= t('devise.passwords.edit.title') %>
  </h2>
  <% if flash.any? %>
    <div class="mb-4 space-y-2">
      <% flash.each do |key, value| %>
        <div class="rounded-lg p-4 text-sm <%= flash_class(key) %>" role="alert">
          <%= value %>
        </div>
      <% end %>

    </div>
  <% end %>

  <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, data: { turbo: "false" } }) do |f| %>
    <%= f.hidden_field :reset_password_token %>
    <%= f.error_notification class: "bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative text-center text-sm mb-4" %>
    <%= f.full_error :reset_password_token, class: "text-red-600 text-sm text-center mb-4 block font-medium" %>
    <div class="form-inputs space-y-4">
      <%= f.input :password, required: false, label: t("devise.form.password") do %>
        <div class="relative" data-controller="password-visibility">
          <%= f.input_field :password,
            autocomplete: "current-password",
            data: { password_visibility_target: "input" },
            class: "w-full px-3 py-2 pr-12 text-sm text-gray-900 border rounded-md focus:outline-none focus:ring-2 #{f.object.errors[:password].present? ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-blue-500'}" %>
          <button type="button" class="absolute inset-y-0 right-1 flex items-center pr-3 text-gray-400 hover:text-gray-600 focus:outline-none" data-action="click->password-visibility#toggle">
            <svg class="h-5 w-5" data-password-visibility-target="eye" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            <svg class="h-5 w-5 hidden" data-password-visibility-target="eyeSlash" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
            </svg>
          </button>
        </div>
      <% end %>

      <%= f.input :password_confirmation, required: false, label: t('activerecord.attributes.user.password_confirmation') do %>
        <div class="relative" data-controller="password-visibility">
          <%= f.input_field :password_confirmation,
            autocomplete: "new-password",
            data: { password_visibility_target: "input" },
            class: "w-full px-3 py-2 pr-12 text-sm text-gray-900 border rounded-md focus:outline-none focus:ring-2 #{f.object.errors[:password_confirmation].present? ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-blue-500'}" %>
          <button type="button" class="absolute inset-y-0 right-1 flex items-center pr-3 text-gray-400 hover:text-gray-600 focus:outline-none" data-action="click->password-visibility#toggle">
            <svg class="h-5 w-5" data-password-visibility-target="eye" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
            <svg class="h-5 w-5 hidden" data-password-visibility-target="eyeSlash" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" /></svg>
          </button>
        </div>
      <% end %>

    </div>
    <div class="form-actions mt-5">
      <button type="submit" class="w-full flex items-center justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-semibold bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer transition-colors duration-200">
        <%= t('devise.passwords.edit.submit') %>
      </button>
    </div>
  <% end %>

  <div class="mt-8">
    <%= render "devise/shared/links" %>
  </div>
</div>
