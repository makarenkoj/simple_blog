<div class="max-w-md mx-auto mt-12 bg-white p-6 rounded-lg shadow-md">
  <h2 class="text-xl font-bold text-gray-800 mb-4 text-center">
    <%= t('devise.passwords.new.title') %>
  </h2>
  <% if flash.any? %>
    <div class="mb-4 space-y-2">
      <% flash.each do |key, value| %>
        <div class="rounded-lg p-4 text-sm <%= flash_class(key) %>" role="alert">
          <%= value %>
        </div>
      <% end %>
    </div>
  <% end %>
  <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, data: { turbo: "false" } }) do |f| %>
    <%= f.error_notification class: "bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative text-center text-sm" %>
    <div class="form-inputs space-y-3">
      <%= f.input :email,
        required: false,
        autofocus: true,
        input_html: {
          autocomplete: "email",
          class: "w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        },
        label: t('devise.form.email') %>
    </div>
    <div class="form-actions mt-6">
      <%= f.button :submit, t('devise.passwords.new.submit', default: "Send me reset password instructions"),
          class: 'w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-base font-medium text-gray-700 bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer' %>
    </div>
  <% end %>
  <div class="mt-8">
    <%= render "devise/shared/links" %>
  </div>
</div>
