<div class="max-w-md mx-auto mt-12 bg-white p-6 rounded-lg shadow-md">
  <h2 class="text-xl font-bold text-gray-800 mb-4 text-center">
    <%= t('activerecord.attributes.user.edit_profile') %>
  </h2>
  <% if flash.any? %>
    <div class="mb-4 space-y-2">
      <% flash.each do |key, value| %>
        <div class="rounded-lg p-4 text-sm <%= flash_class(key) %>" role="alert">
          <%= value %>
        </div>
      <% end %>
    </div>
  <% end %>
  <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, data: { turbo: "false" } }) do |f| %>
    <%= f.error_notification class: "bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative text-center text-sm mb-4" %>
    <div class="form-inputs space-y-4">
      <div class="form-group text-center mb-6">
        <% if f.object.persisted? && f.object.avatar.attached? %>
          <%= image_tag f.object.avatar.representation(resize_to_limit: [150, 150], format: :webp).processed, loading: "lazy", title: f.object.username, alt: f.object.username, class: "rounded-full w-32 h-32 object-cover mx-auto mb-4 shadow-md" %>
          <%= link_to t('buttons.remove_avatar'),
                      rails_blob_path(f.object.avatar, disposition: "attachment"),
                      data: { turbo_method: :delete, turbo_confirm: t('confirm_remove_avatar') },
                      title: t('buttons.remove_avatar'),
                      class: "block text-red-600 hover:underline text-sm mt-2" %>
        <% else %>
          <div class="rounded-full w-32 h-32 bg-gray-300 flex items-center justify-center mx-auto mb-4 text-gray-600 text-5xl font-bold">
            <%= f.object.username.first.upcase if f.object.username.present? %>
          </div>
        <% end %>
        <%= f.input :avatar, as: :file,
                    input_html: { class: "block w-full text-sm text-gray-900 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" },
                    label: t('activerecord.attributes.user.avatar') %>
      </div>
      <%= f.input :username, required: true, label: t('activerecord.attributes.user.username'), input_html: { class: "w-full px-3 py-2 text-sm text-gray-900 border border-gray-300 rounded-md focus:outline-none focus:ring-3 focus:ring-blue-500" } %>
      <%= f.input :email, required: true, label: t('activerecord.attributes.user.email'), input_html: { class: "w-full px-3 py-2 text-sm text-gray-900 border border-gray-300 rounded-md focus:outline-none focus:ring-3 focus:ring-blue-500" } %>
      <%= f.input :first_name, required: true, label: t('activerecord.attributes.user.first_name'), input_html: { class: "w-full px-3 py-2 text-sm text-gray-900 border border-gray-300 rounded-md focus:outline-none focus:ring-3 focus:ring-blue-500" } %>
      <%= f.input :last_name, required: true, label: t('activerecord.attributes.user.last_name'), input_html: { class: "w-full px-3 py-2 text-sm text-gray-900 border border-gray-300 rounded-md focus:outline-none focus:ring-3 focus:ring-blue-500" } %>
      <div class="mt-4">
        <label class="block text-sm font-medium text-gray-700 mb-2"><%= t('activerecord.attributes.user.preferred_categories') %></label>
        <div class="grid grid-cols-2 gap-2 p-3 border border-gray-300 rounded-md bg-gray-50">
          <% Category.all.order(:name).each do |category| %>
            <label class="flex items-center text-sm text-gray-700 cursor-pointer">
              <%= check_box_tag 'user[preferred_category_ids][]', 
                  category.id, 
                  @user.preferred_category_ids.include?(category.id), 
                  class: "w-4 h-4 rounded border-gray-300 text-blue-600 shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50" %>
              <span class="ml-2"><%= category.name %></span>
            </label>
          <% end %>
        </div>
      </div>
      <hr class="my-6 border-gray-200">
      <h3 class="text-lg font-medium text-gray-800 mb-2"><%= t('activerecord.attributes.user.change_password') %></h3>
      <%= f.input :password, required: false, label: t('activerecord.attributes.user.new_password') do %>
        <div class="relative" data-controller="password-visibility">
          <%= f.input_field :password, autocomplete: "new-password", data: { password_visibility_target: "input" }, class: "w-full px-3 py-2 pr-12 text-sm text-gray-900 border border-gray-300 rounded-md focus:outline-none focus:ring-3 focus:ring-blue-500" %>
          <button type="button" class="absolute inset-y-0 right-1 flex items-center pr-3 text-gray-400 hover:text-gray-600 focus:outline-none" data-action="click->password-visibility#toggle">
            <svg class="h-5 w-5" data-password-visibility-target="eye" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
            <svg class="h-5 w-5 hidden" data-password-visibility-target="eyeSlash" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" /></svg>
          </button>
        </div>
      <% end %>
      <%= f.input :password_confirmation, required: false, label: t('activerecord.attributes.user.password_confirmation') do %>
        <div class="relative" data-controller="password-visibility">
          <%= f.input_field :password_confirmation, autocomplete: "new-password", data: { password_visibility_target: "input" }, class: "w-full px-3 py-2 pr-12 text-sm text-gray-900 border border-gray-300 rounded-md focus:outline-none focus:ring-3 focus:ring-blue-500" %>
          <button type="button" class="absolute inset-y-0 right-1 flex items-center pr-3 text-gray-400 hover:text-gray-600 focus:outline-none" data-action="click->password-visibility#toggle">
            <svg class="h-5 w-5" data-password-visibility-target="eye" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
            <svg class="h-5 w-5 hidden" data-password-visibility-target="eyeSlash" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" /></svg>
          </button>
        </div>
      <% end %>
      <%= f.input :current_password, required: false, label: t('activerecord.attributes.user.current_password') do %>
        <div class="relative" data-controller="password-visibility">
          <%= f.input_field :current_password, autocomplete: "current-password", data: { password_visibility_target: "input" }, class: "w-full px-3 py-2 pr-12 text-sm text-gray-900 border border-gray-300 rounded-md focus:outline-none focus:ring-3 focus:ring-blue-500" %>
          <button type="button" class="absolute inset-y-0 right-1 flex items-center pr-3 text-gray-400 hover:text-gray-600 focus:outline-none" data-action="click->password-visibility#toggle">
            <svg class="h-5 w-5" data-password-visibility-target="eye" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
            <svg class="h-5 w-5 hidden" data-password-visibility-target="eyeSlash" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" /></svg>
          </button>
        </div>
        <p class="text-xs text-gray-500 mt-1"><%= t('simple_form.labels.defaults.comment_password') %></p>
      <% end %>
    </div>
    <div class="form-actions mt-6">
      <button type="submit" class="w-full flex items-center justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-base font-medium  bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer transition-colors duration-200">
        <%= t("simple_form.button.update") %>
      </button>
    </div>
  <% end %>
  <div class="mt-4 pt-2 text-center space-y-4">
    <%= link_to t("simple_form.button.back"), :back, title: t("simple_form.button.back"), class: "text-sm text-blue-600 hover:underline inline-block" %>
  </div>
  <div class="mt-8 pt-6 border-t border-gray-200 text-center space-y-4">
    <%= button_to t("simple_form.labels.defaults.cancel"), 
                  registration_path(resource_name), 
                  method: :delete, 
                  form: {
                    data: { turbo: "false" }, 
                    onsubmit: "return confirm('#{t("simple_form.labels.defaults.confirm")}');" 
                  }, 
                  class: "text-sm text-red-600 hover:underline bg-transparent border-none p-0 cursor-pointer" %>
    </div>
  </div>
</div>
