<div style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; color: #374151; line-height: 1.6; background-color: #f9fafb;">
  <div style="background-color: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 40px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
    <h2 style="color: #111827; margin-top: 0; font-size: 24px; font-weight: 600;">
      <%= t('devise.mailer.reset_password_instructions.greeting', name: @resource.first_name.presence || @resource.username) %>
    </h2>
    <p style="font-size: 16px; color: #4b5563;">
      <%= t('devise.mailer.reset_password_instructions.instruction', username: @resource.username) %>
    </p>
    <div style="text-align: center; margin: 35px 0;">
      <%= link_to t('devise.mailer.reset_password_instructions.action'), 
                  edit_password_url(@resource, reset_password_token: @token), 
                  style: "background-color: #2563eb; color: #ffffff; padding: 14px 28px; text-decoration: none; border-radius: 8px; font-size: 16px; font-weight: 600; display: inline-block;" %>
    </div>
    <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 30px 0;">
    <div style="background-color: #fff1f2; border-left: 4px solid #e11d48; padding: 15px; border-radius: 4px;">
      <p style="color: #be123c; font-size: 14px; margin: 0 0 10px 0; font-weight: 500;">
        ⚠️ <%= t('devise.mailer.reset_password_instructions.security_warning') %>
      </p>
      <p style="color: #9f1239; font-size: 14px; margin: 0;">
        <%= raw t('devise.mailer.reset_password_instructions.support_html', support_email: ENV.fetch('ADMIN_EMAIL', 'help.booost@gmail.com')) %>
      </p>
    </div>
  </div>
  <div style="text-align: center; margin-top: 20px; color: #9ca3af; font-size: 12px;">
    <p>© <%= Time.current.year %> <%= t('devise.mailer.reset_password_instructions.our_company') %></p>
  </div>
</div>
