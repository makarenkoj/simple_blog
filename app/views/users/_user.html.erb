<span class="user">
  <span class="user-avatar">
    <%= image_tag(user_avatar(user), loading: "lazy", title: user.username, alt: user.username, class: 'img-icon') %>
  </span>
  <span class="user-name">
    <% if request.path == user_path(user) %>
      <%= user.name %>
    <% else %>
      <%= link_to user.name, user_path(user) %>
    <% end %>
  </span>
</span>
