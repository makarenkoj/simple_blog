<% content_for :title, @post.title %>
<% title @post.title %>
<% description truncate(strip_tags(@post.body.to_s), length: 160) %>
<% set_meta_tags(og: { title: @post.title,
                       type: 'article',
                       image: @post.cover_image.attached? ? url_for(@post.cover_image) : nil
                     },
                     twitter: {
                       card: 'summary_large_image',
                       title: @post.title,
                       description: truncate(strip_tags(@post.body.to_s), length: 160),
                       image: @post.cover_image.attached? ? url_for(@post.cover_image) : nil
                     }
                   ) %>

<div class="min-h-screen bg-white">
  <nav class="sticky top-0 z-40 bg-white border-b border-slate-200 backdrop-blur-sm bg-white/95">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center space-x-6">
          <% unless turbo_native_app? %>
            <%= link_to posts_path, title: t('app.home'), class: "flex items-center space-x-2 text-slate-600 hover:text-slate-900 transition-colors duration-200 group" do %>
              <svg class="w-5 h-5 group-hover:-translate-x-0.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
              </svg>
              <span class="hidden sm:inline font-medium"><%= t('activerecord.post.back', default: 'Назад') %></span>
            <% end %>
            <div class="h-6 w-px bg-slate-200"></div> 
          <% end %>
          <% if user_signed_in? %>
            <%= render "posts/likes/button", post: @post %>
          <% else %>
            <%= link_to new_user_session_path, title: t('activerecord.attributes.user.sign_in'), class: "flex items-center space-x-2 text-slate-600" do %>
              <i class='bx bx-like text-2xl'></i>
              <span class="text-sm font-medium"><%= @post.likes.count %></span>
            <% end %>
          <% end %>
        </div>
        <div class="flex items-center space-x-3">
          <% if current_user_can_edit?(@post) %>
            <div class="relative inline-block text-left mr-1 sm:mr-2" data-controller="dropdown">
              <button type="button" 
                      class='inline-flex items-center px-4 py-2 bg-white border border-slate-200 rounded-md text-xs font-medium hover:bg-slate-50 transition-colors text-slate-800'
                      data-action="click->dropdown#toggle"
                      data-dropdown-target="toggle"
                      title="<%= t('activerecord.attributes.posts.change_status_title') %>">
                <span class="max-sm:hidden">
                  <%= t("activerecord.attributes.posts.status_badge.#{@post.status}") %>
                </span>
                <span class="sm:hidden">
                  <%= t("activerecord.attributes.posts.#{@post.status}_short") %>
                </span>
                <svg class="ml-2 w-4 h-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div class="dropdown-hidden absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg ring-1 ring-black ring-opacity-5 z-50 p-1" data-dropdown-target="menu">
                <% Post.statuses.keys.reject { |s| s == @post.status.to_s }.each do |target_status| %>
                  <%= button_to post_path(@post), method: :patch, params: { post: { status: target_status } }, form: { data: { turbo: false } }, class: 'w-full text-left px-3 py-2 text-sm hover:bg-slate-50 rounded-md transition-colors text-slate-800' do %>
                    <%= t("activerecord.attributes.posts.statuses.#{target_status}") %>
                  <% end %>
                <% end %>
              </div>
            </div>
            <%= link_to edit_post_path(@post), title: t('activerecord.attributes.posts.edit'), class: "px-2 sm:px-4 py-2 text-sm font-medium text-slate-800 hover:text-slate-900 transition-colors duration-200" do %>
              <%= t('activerecord.attributes.posts.edit') %>
            <% end %>
          <% end %>
          <% if user_signed_in? %>
            <%= render "posts/bookmarks/button", post: @post, source: local_assigns[:source] %>
          <% else %>
            <%= link_to new_user_session_path, title: t('activerecord.attributes.user.sign_in'), class: "text-slate-400 hover:text-slate-900 transition-colors duration-200" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
              </svg>
            <% end %>
          <% end %>
          <%= render "posts/share/button", post: @post %>
        </div>
      </div>
    </div>
  </nav>
  <article class="mx-auto max-w-3xl">
    <header class="px-6 sm:px-8 pt-12 sm:pt-16 pb-8">
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-slate-900 mb-3 leading-tight tracking-tight group-hover:underline line-clamp-2">
        <%= @post.title %>
      </h1>
      <div class="flex items-center justify-between flex-wrap gap-4">
        <% if @post.user.present? %>
          <%= link_to user_path(@post.user), title: t('activerecord.attributes.user.profile') + " " + @post.user.username, class: "flex items-center space-x-3 group" do %>
            <% if @post.user.avatar.attached? %>
              <%= image_tag @post.user.avatar.representation(resize_to_limit: [48, 48], format: :webp).processed,
                            loading: "eager",
                            class: "w-12 h-12 rounded-full object-cover",
                            alt: @post.user.username,
                            title: @post.user.username %>
            <% else %>
              <div class="w-12 h-12 rounded-full bg-slate-900 flex items-center justify-center text-white font-semibold">
                <%= @post.user.username&.first&.upcase || '?' %>
              </div>
            <% end %>
            <div>
              <p class="text-sm font-medium text-slate-900 group-hover:underline">
                <%= @post.user.username %>
              </p>
              <div class="flex items-center text-sm text-slate-600 space-x-2">
                <time datetime="<%= @post.created_at.iso8601 %>">
                  <%= l @post.created_at, format: :long %>
                </time>
                <span>·</span>
                <span><%= @post.body.to_plain_text.split.size / 200 %> <%= t('activerecord.attributes.posts.index.min_read') %></span>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </header>
    <% if @post.cover_image.attached? %>
      <figure class="mb-12">
        <%= image_tag @post.cover_image.representation(resize_to_limit: [1400, 800], format: :webp, saver: { quality: 80 }).processed,
            class: "w-full h-auto",
            fetchpriority: "high",
            alt: @post.title,
            title: @post.title %>
      </figure>
    <% end %>
    <div class="px-6 sm:px-8 pb-16">
      <div class="prose prose-lg max-w-none medium-prose">
        <%= @post.body %>
      </div>
    </div>
    <% if @post.categories.any? %>
      <div class="px-6 sm:px-8 pb-8">
        <div class="flex flex-wrap gap-2">
          <% @post.categories.each do |category| %>
            <%= link_to '#', title: category.name, class: "px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-full text-sm font-medium transition-colors duration-200" do %>
              <%= category.name %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
    <% if @post.user.present? %>
      <div class="px-6 sm:px-8 pb-16">
        <%= link_to user_path(@post.user), title: t('activerecord.attributes.user.profile') + " " + @post.user.username, class: "flex items-start space-x-4 p-6 border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors duration-200 group" do %>
          <% if @post.user.avatar.attached? %>
            <%= image_tag @post.user.avatar.representation(resize_to_limit: [80, 80], format: :webp).processed,
                          loading: "lazy",
                          class: "w-20 h-20 rounded-full object-cover flex-shrink-0",
                          alt: @post.user.username,
                          title: @post.user.username %>
          <% else %>
            <div class="w-20 h-20 rounded-full bg-slate-900 flex items-center justify-center text-white font-bold text-2xl flex-shrink-0">
              <%= @post.user.username&.first&.upcase || '?' %>
            </div>
          <% end %>
          <div class="flex-1 min-w-0">
            <p class="text-base font-semibold text-slate-900 mb-1 group-hover:underline">
              <%= @post.user.username %>
            </p>
            <div class="flex items-center space-x-4 mt-3">
              <span class="text-xs text-slate-500"><%= @post.user.followers.size %> <%= t('followers') %></span>
              <span class="text-xs text-slate-500"><%= @post.user.posts.size %> <%= t('posts') %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
    <% if current_user_can_edit?(@post) %>
      <div class="px-6 sm:px-8 pb-16">
        <div class="p-6 bg-amber-50 border border-amber-200 rounded-lg">
          <div class="flex items-start space-x-3 mb-4">
            <svg class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
            </svg>
            <div>
              <h3 class="text-sm font-semibold text-amber-900 mb-1">
                <%= t('activerecord.attributes.posts.admin_mode') %>
              </h3>
              <p class="text-sm text-amber-700 mb-4">
                <%= t('activerecord.attributes.posts.admin_mode_desc') %>
              </p>
              <div class="flex flex-wrap gap-3">
                <%= link_to edit_post_path(@post), title: t('activerecord.attributes.posts.edit'), class: 'inline-flex items-center px-4 py-2 bg-white border border-amber-300 rounded-md text-sm font-medium text-amber-900 hover:bg-amber-100 transition-colors duration-200' do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                  </svg>
                  <%= t('activerecord.attributes.posts.edit') %>
                <% end %>
                <%= link_to post_path(@post), title: t('activerecord.attributes.posts.destroy'), data: { turbo_confirm: t('activerecord.attributes.posts.destroy_confirm'), turbo_method: :delete }, class: 'inline-flex items-center px-4 py-2 bg-white border border-red-300 rounded-md text-sm font-medium text-red-900 hover:bg-red-50 transition-colors duration-200' do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                  </svg>
                  <%= t('activerecord.attributes.posts.destroy') %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </article>
  <div class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto py-16" style="max-width: 1200px;">
      <div class="px-6 sm:px-8">
        <h2 class="text-2xl font-bold text-slate-900 mb-8">
          <%= t('activerecord.attributes.posts.more_from_author', author: @post.user&.username) %>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <% @more_from_author.each do |post| %>
            <%= link_to post_path(post), title: post.title, class: "group cursor-pointer block" do %>
              <div class="aspect-video bg-slate-200 rounded-lg mb-4 overflow-hidden relative">
                <% if post.cover_image.attached? %>
                  <%= image_tag post.cover_image.variant(resize_to_fill: [400, 225], format: :webp).processed,
                      class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300",
                      loading: "lazy",
                      alt: post.title,
                      title: post.title %>
                <% else %>
                  <div class="w-full h-full bg-gradient-to-br from-slate-200 to-slate-300 flex items-center justify-center">
                    <svg class="w-10 h-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                  </div>
                <% end %>
              </div>
              <h3 class="font-bold text-slate-900 mb-2 group-hover:underline line-clamp-2 leading-tight">
                <%= post.title %>
              </h3>
              <p class="text-sm text-slate-600 mb-3 line-clamp-2">
                <% if post.body.present? %>
                  <%= truncate(post.body.to_plain_text, length: 120) %>
                <% end %>
              </p>
              <div class="flex items-center text-xs text-slate-500 space-x-2">
                <span><%= (post.body.to_plain_text.split.size / 200.0).ceil %> <%= t('min_read') %></span>
                <span>·</span>
                <time datetime="<%= post.created_at.iso8601 %>">
                  <%= l(post.created_at, format: :short) %>
                </time>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
