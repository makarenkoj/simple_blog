<article id="<%= dom_id(post) %>" class="py-8 border-b border-slate-200 last:border-none">
  <div class="flex flex-col sm:flex-row gap-6">
    <div class="flex-1 min-w-0">
      <div class="flex items-center space-x-3 mb-4">
        <% if post.user.present? %>
          <%= link_to user_path(post.user), title: t('notifications.view_profile') do %>
            <% if post.user.avatar.attached? %>
              <%= image_tag post.user.avatar.representation(resize_to_limit: [24, 24], format: :webp, saver: { quality: 80 }).processed, width: 24, height: 24, loading: "lazy", title: post.user.username, alt: post.user.username, class: "w-6 h-6 rounded-full object-cover" %>
            <% else %>
              <div class="w-6 h-6 rounded-full bg-slate-900 flex items-center justify-center text-white text-xs font-semibold">
                <%= post.user.username&.first&.upcase || '?' %>
              </div>
            <% end %>
            <span class="text-sm font-medium text-slate-900 hover:underline">
              <%= link_to post.user.username, user_path(post.user), title: t('notifications.view_profile') %>
            </span>
          <% end %>
        <% end %>
      </div>
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-2 leading-tight group-hover:underline line-clamp-2">
        <%= link_to post.title, post_path(post), title: t('activerecord.attributes.posts.view_post') %>
      </h2>
      <% if post.body.present? %>
        <p class="text-slate-600 text-base mb-4 line-clamp-2 hidden sm:block">
          <%= truncate(post.body.to_plain_text, length: 120, separator: ' ') %>
        </p>
      <% end %>
      <div class="flex items-center space-x-4 text-sm text-slate-600">
        <time datetime="<%= post.created_at.iso8601 %>">
          <%= l post.created_at, format: :short %>
        </time>
        <span><%= post.body.to_plain_text.split.size / 200 %> <%= t('activerecord.attributes.posts.index.min_read') %></span>
        <% if post.categories.any? %>
          <span class="max-sm:hidden">
            <% post.categories.sample(3).each do |category| %>
              <%= link_to category_path(category), title: category.name, class: "px-2 py-1 bg-slate-100 rounded-md text-xs font-medium text-slate-800 hover:bg-slate-200 transition-colors" do %>
                <%= category.name %>
              <% end %>
            <% end %>
          </span>
          <span class="sm:hidden">
            <%= link_to category_path(post.categories.first.name), title: post.categories.first.name, class: "px-2 py-1 bg-slate-100 rounded-md text-xs font-medium text-slate-800 hover:bg-slate-200 transition-colors" do %>
              <%= post.categories.first.name %>
            <% end %>
          </span>
        <% end %>
        <div class="ml-auto flex items-center space-x-4">
          <% if user_signed_in? && current_user == post.user %>
            <div class="relative inline-block text-left" data-controller="dropdown">
              <button type="button" 
                      class='inline-flex items-center px-4 py-2 bg-white border border-slate-200 rounded-md text-xs font-medium hover:bg-slate-50 transition-colors text-slate-800'
                      data-action="click->dropdown#toggle"
                      data-dropdown-target="toggle"
                      title="<%= t('activerecord.attributes.posts.change_status_title') %>">
                <span class="max-sm:hidden">
                  <%= t("activerecord.attributes.posts.status_badge.#{post.status}") %>
                </span>
                <span class="sm:hidden">
                  <%= t("activerecord.attributes.posts.#{post.status}_short") %>
                </span>
                <svg class="ml-1.5 w-3 h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div class="dropdown-hidden absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg ring-1 ring-black ring-opacity-5 z-50 p-1" data-dropdown-target="menu">
                <% Post.statuses.keys.reject { |s| s == post.status.to_s }.each do |target_status| %>
                  <%= button_to post_path(post), method: :patch, params: { post: { status: target_status } }, title: t("activerecord.attributes.posts.statuses.#{target_status}"), class: 'w-full text-left px-3 py-2 text-sm hover:bg-slate-50 rounded-md transition-colors flex items-center group text-slate-800' do %>
                    <%= t("activerecord.attributes.posts.statuses.#{target_status}") %>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
          <% if user_signed_in? %>
            <%= render "posts/bookmarks/button", post: post, source: local_assigns[:source] %>
          <% else %>
            <%= link_to new_user_session_path, title: t('activerecord.attributes.posts.sign_in_to_bookmark'), class: "text-slate-600 hover:text-slate-900 transition-colors duration-200" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
              </svg>
            <% end %>
          <% end %>
          <%= render "posts/share/button", post: post %>
        </div>
      </div>
    </div>
    <% if post.cover_image.attached? %>
      <div class="w-full sm:w-48 h-32 sm:h-32 flex-shrink-0 order-first sm:order-last">
        <% if local_assigns[:post_counter] == 0 %>
          <%= image_tag post.cover_image.representation(resize_to_limit: [400, 300], format: :webp, saver: { quality: 80 }).processed,
                        class: "w-full h-full object-cover rounded-xl shadow-sm border border-slate-100", 
                        fetchpriority: "high",
                        alt: post.title, 
                        title: post.title %>
        <% else %>
          <%= image_tag post.cover_image.representation(resize_to_limit: [400, 300],
                        format: :webp,
                        saver: { quality: 80 }).processed,
                        class: "w-full h-full object-cover rounded-xl shadow-sm border border-slate-100",
                        loading: "lazy",
                        alt: post.title,
                        title: post.title %>
        <% end %>
      </div>
    <% end %>
  </div>
</article>
