<footer class="bg-slate-50 border-t border-slate-200 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 md:gap-4">
      
      <div class="text-sm text-slate-500 font-medium md:w-1/3 text-center md:text-left">
        <span class="text-slate-900 font-bold"><%= t('app.company') %></span>
        <span class="mx-2 text-slate-300">|</span>
        &copy; <%= Date.current.year %>
      </div>

      <nav class="flex flex-wrap justify-center gap-6 text-sm text-slate-600 md:w-1/3">
        <%= link_to t('about.title'), about_path, title: t('about.title'), class: "hover:text-slate-900 hover:underline transition-colors" %>
        <%= link_to t('terms.title'), terms_path, title: t('terms.title'), class: "hover:text-slate-900 hover:underline transition-colors" %>
        <%= link_to t('privacy.title'), privacy_policy_path, title: t('privacy.title'), class: "hover:text-slate-900 hover:underline transition-colors" %>
      </nav>

      <div class="flex items-center justify-center md:justify-end text-sm text-slate-400 md:w-1/3">
        <span><%= t('app.crafted_with') %></span>
        <i class='bx bxs-heart text-slate-300 mx-1.5 hover:text-red-400 transition-colors duration-300 cursor-default'></i>
        <span><%= t('app.by') %></span>
        <a href="https://github.com/makarenkoj" target="_blank" class="ml-1.5 text-xl font-medium text-slate-500 hover:text-slate-900 transition-colors duration-300" style="font-family: 'Caveat', cursive;">
          <%= t('app.author') %>
        </a>
      </div>

    </div>
  </div>
</footer>
